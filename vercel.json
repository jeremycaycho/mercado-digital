{
  "rewrites": [
    {
      "source": "/puesto/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|TelegramBot|Twitterbot|Slackbot|LinkedInBot|Discordbot).*"
        }
      ],
      "destination": "/api/og?id=:id"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
